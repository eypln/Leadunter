# ============================================
# NEXTAUTH CONFIGURATION
# ============================================

# Base URL of your application
# Development: http://localhost:3000
# Production: https://your-domain.vercel.app
NEXTAUTH_URL="http://localhost:3000"

# Secret key for NextAuth session encryption
# Generate with: openssl rand -base64 32
# IMPORTANT: Keep this secret and never commit to Git
NEXTAUTH_SECRET="your-secret-key-here-generate-with-openssl"

# ============================================
# FACEBOOK OAUTH CREDENTIALS
# ============================================

# Get these from: https://developers.facebook.com/apps/
# 1. Create a new app
# 2. Add Facebook Login product
# 3. Copy App ID and App Secret

FACEBOOK_CLIENT_ID="1721260389288492"
FACEBOOK_CLIENT_SECRET="8107ccf48c5087236fcee7b9fc040ab3"

# ============================================
# AI PROVIDER (Choose ONE)
# ============================================

# Option 1: OpenAI (Recommended for MVP)
# Get from: https://platform.openai.com/api-keys
# Cost: ~$0.01 per lead with GPT-3.5-turbo
OPENAI_API_KEY="sk-..."

# Option 2: Anthropic Claude (Alternative)
# Get from: https://console.anthropic.com/
# Uncomment if using Claude instead of OpenAI
# ANTHROPIC_API_KEY="sk-ant-..."

# AI Model Selection (optional, defaults to gpt-3.5-turbo)
AI_MODEL="gpt-3.5-turbo"
# Alternative: "gpt-4" (more expensive but more accurate)
# Alternative: "claude-3-sonnet-20240229" (if using Anthropic)

# ============================================
# SCRAPER CONFIGURATION
# ============================================

# Facebook account credentials for scraping
# IMPORTANT: Use a dedicated account, NOT your personal account
# Risk: Account may be banned if Facebook detects scraping
FACEBOOK_SCRAPER_EMAIL="scraper-account@example.com"
FACEBOOK_SCRAPER_PASSWORD="secure-password-here"

# Cron schedule for automated scraping (cron syntax)
# Default: "0 */6 * * *" = Every 6 hours at minute 0
# Examples:
#   "0 */4 * * *" = Every 4 hours
#   "0 9,15,21 * * *" = At 9 AM, 3 PM, and 9 PM
#   "0 0 * * *" = Once daily at midnight
SCRAPER_CRON_SCHEDULE="0 */6 * * *"

# Facebook Groups to monitor (comma-separated URLs)
# Example: https://www.facebook.com/groups/123456789
FACEBOOK_GROUPS="https://www.facebook.com/groups/malta-rentals,https://www.facebook.com/groups/malta-property"

# Facebook Marketplace URL for Malta
# Default: Malta Marketplace rentals
FACEBOOK_MARKETPLACE_URL="https://www.facebook.com/marketplace/malta/propertyrentals"

# Lead types to scrape (comma-separated: OWNER, CLIENT, or both)
# OWNER = Property owners offering rentals
# CLIENT = People looking to rent
SCRAPER_LEAD_TYPES="OWNER,CLIENT"

# Scraper behavior settings
SCRAPER_MAX_POSTS_PER_RUN="50"  # Maximum posts to scrape per job
SCRAPER_DELAY_MIN="2000"        # Minimum delay between requests (ms)
SCRAPER_DELAY_MAX="5000"        # Maximum delay between requests (ms)

# Image handling
SCRAPER_EXTRACT_IMAGE_URLS="true"  # Extract image URLs during scraping
SCRAPER_AUTO_DOWNLOAD_IMAGES="false"  # Do NOT auto-download (manual approval only)

# ============================================
# OPTIONAL: MONITORING & LOGGING
# ============================================

# Sentry DSN for error tracking (optional)
# SENTRY_DSN="https://xxxxx@xxxxx.ingest.sentry.io/xxxxx"

# Log level (optional, defaults to "info")
# Options: "debug", "info", "warn", "error"
LOG_LEVEL="info"

# ============================================
# OPTIONAL: NOTIFICATIONS
# ============================================

# Slack webhook for scraper job notifications (optional)
# SLACK_WEBHOOK_URL="https://hooks.slack.com/services/xxx/xxx/xxx"

# Email for admin notifications (optional)
# ADMIN_EMAIL="admin@example.com"

# ============================================
# DEVELOPMENT ONLY
# ============================================

# Skip AI analysis in development (use mock scores)
# DEV_SKIP_AI="true"

# Use mock scraper data instead of real Facebook scraping
# DEV_USE_MOCK_DATA="true"
