# ============================================
# SUPABASE CONFIGURATION
# ============================================

# Get these from: Supabase Project Settings > API
# Required for database and storage

NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key-here"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key-here"

# Supabase Storage bucket for lead images
SUPABASE_STORAGE_BUCKET="lead-images"

# ============================================
# NEXTAUTH CONFIGURATION
# ============================================

# Base URL of your application
# Development: http://localhost:3000
# Production: https://your-domain.vercel.app
NEXTAUTH_URL="http://localhost:3000"

# Secret key for NextAuth session encryption
# Generate with: openssl rand -base64 32
# IMPORTANT: Keep this secret and never commit to Git
NEXTAUTH_SECRET="your-secret-key-here-generate-with-openssl"

# ============================================
# GOOGLE OAUTH CREDENTIALS
# ============================================

# Get these from: https://console.cloud.google.com/
# 1. Create a project → APIs & Services → Credentials
# 2. Create OAuth 2.0 Client ID (Web application)
# 3. Add Authorized redirect URI: https://your-domain.com/api/auth/callback/google

GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# ============================================
# AI PROVIDER - GOOGLE GEMINI
# ============================================

# Get from: https://aistudio.google.com/app/apikey
# Gemini API is free for moderate usage
GEMINI_API_KEY="AIzaSyD3WZbA82MSLRRQ9l7Tkx4Kt6MVOA6WjgY"

# Gemini Model Selection (optional, defaults to gemini-1.5-flash)
# Options: "gemini-1.5-flash" (fast, free), "gemini-1.5-pro" (more capable)
GEMINI_MODEL="gemini-1.5-flash"

# ============================================
# APIFY INTEGRATION (SCRAPER)
# ============================================

# Get your API token from: https://console.apify.com/account/integrations
# Apify handles Facebook scraping with proxies and anti-ban protection
APIFY_API_TOKEN="apify_api_OyQ8bpq1jDtKjtecHw9sZm56Xorxea2C733X"

# Apify Actor ID for Facebook scraping
# Default: apify/facebook-pages-scraper (or your custom actor)
# You can also use: apify/facebook-groups-scraper
APIFY_ACTOR_ID="apify/facebook-groups-scraper"

# Your application's webhook URL (where Apify sends results)
# Development: Use ngrok or similar tunnel service
# Production: https://your-domain.vercel.app/api/webhooks/apify
APIFY_WEBHOOK_URL="https://your-domain.vercel.app/api/webhooks/apify"

# Facebook Groups to monitor (comma-separated URLs)
# Use direct group URLs only: https://www.facebook.com/groups/GROUP_ID
# Do NOT use share/g/ links — they require login and will fail.
FACEBOOK_GROUPS="https://www.facebook.com/groups/maltarealestate"

# Facebook Marketplace URL for Malta
# Default: Malta Marketplace rentals
FACEBOOK_MARKETPLACE_URL="https://www.facebook.com/marketplace/malta/propertyrentals"

# Scraper behavior settings
SCRAPER_MAX_POSTS_PER_RUN="50"  # Maximum posts to scrape per job

# How far back to look for posts (default: 7 days)
# Examples: "1 day", "3 days", "7 days", "30 days"
SCRAPER_POSTS_NEWER_THAN="7 days"

# ============================================
# FACEBOOK SESSION COOKIE (for private groups)
# ============================================

# Required to scrape private/closed Facebook groups.
# Without this, only public groups like facebook.com/groups/maltarealestate work.
#
# HOW TO GET YOUR COOKIE:
# 1. Open Chrome/Firefox and log in to Facebook (use a dedicated account)
# 2. Open DevTools (F12) → Application tab → Storage → Cookies → https://www.facebook.com
# 3. Find and copy these 4 cookies: c_user, xs, datr, fr
# 4. Paste them in the format below:
#
# SECURITY WARNING:
# - Use a DEDICATED Facebook account, never your personal one
# - Do NOT commit this value to Git (it's in .gitignore via .env.local)
# - Cookies expire every 30-60 days — you'll need to refresh them
# - Add this to Vercel Environment Variables for production
FACEBOOK_COOKIE_STRING=""

# ============================================
# OPTIONAL: MONITORING & LOGGING
# ============================================

# Sentry DSN for error tracking (optional)
# SENTRY_DSN="https://xxxxx@xxxxx.ingest.sentry.io/xxxxx"

# Log level (optional, defaults to "info")
# Options: "debug", "info", "warn", "error"
LOG_LEVEL="info"

# ============================================
# NOTIFICATIONS (RESEND EMAIL SERVICE)
# ============================================

# Get your FREE API key from: https://resend.com/api-keys
# Resend is used for email notifications on scraper job completion/failure
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# Email address to send notifications FROM (must be verified in Resend)
# For testing: Use "onboarding@resend.dev" (no verification needed)
# For production: Use your own domain email (e.g., "noreply@yourdomain.com")
RESEND_FROM_EMAIL="onboarding@resend.dev"

# Email address to send notifications TO (admin email)
ADMIN_EMAIL="triquaestate@gmail.com"

# ============================================
# PWA PUSH NOTIFICATIONS (VAPID KEYS)
# ============================================

# Generate VAPID keys with:
#   npx web-push generate-vapid-keys
# Then copy the output below.

# Public key — also set as NEXT_PUBLIC_VAPID_PUBLIC_KEY for the browser
VAPID_PUBLIC_KEY="your-vapid-public-key"
VAPID_PRIVATE_KEY="your-vapid-private-key"

# The same public key, exposed to the browser via NEXT_PUBLIC_ prefix
NEXT_PUBLIC_VAPID_PUBLIC_KEY="your-vapid-public-key"

# Contact info for VAPID (email or URL)
VAPID_SUBJECT="mailto:admin@leadhunter.app"

# ============================================
# DEVELOPMENT ONLY
# ============================================

# Skip AI analysis in development (use mock scores)
# DEV_SKIP_AI="true"

# Use mock scraper data instead of real Facebook scraping
# DEV_USE_MOCK_DATA="true"
